{
  "manifest_version": 3,
  "name": "inpage-wallet example",
  "version": "0.0.1",
  "description": "Minimal MV3 host for inpage-wallet. No UI framework, window.confirm as the modal.",
  "background": { "service_worker": "src/service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["src/inpage.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*"],
      "js": ["src/content-script.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*/*"],
  "icons": { "48": "icons/icon-48.png" },
  "web_accessible_resources": [{ "resources": ["icons/icon-48.png"], "matches": ["https://*/*"] }]
}
